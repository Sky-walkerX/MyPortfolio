# Public site URL — used by metadata helpers (sitemap, OG, canonical).
NEXT_PUBLIC_SITE_URL=https://namankhandelwal.me

# Optional: server-side GitHub token used during the build/ISR refresh to
# avoid the 60 req/hour unauthenticated rate limit. Read-only access is enough.
# Create one at: https://github.com/settings/tokens?type=beta
# Required scope: none (public repo access only).
GITHUB_TOKEN=
